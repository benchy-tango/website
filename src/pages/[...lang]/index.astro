---
/**
 * HOME, a tango site led by the DJ: hero (DJ portrait, booking CTA) →
 * Music for the dance floor (formats, no photo) → Where I've played (venues, flags) →
 * Classes (quieter band) → About (with a discreet link to the paintings) →
 * booking band. Section order and copy follow navegacion.md.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import VinylSleeve from '../../components/VinylSleeve.astro';
import { DJ_HIGHLIGHTS } from '../../data/dj';
import { enquiryUrl, getTranslation, languageStaticPaths, pageUrl, type Language } from '../../i18n/languages';
import djPhoto from '../../assets/photos/aaron-dj.jpg';
import classPhoto from '../../assets/photos/aaron-class.jpg';
import portraitPhoto from '../../assets/photos/aaron-portrait.jpg';

export const getStaticPaths = languageStaticPaths;

const { language } = Astro.props as { language: Language };
const t = getTranslation(language);
const h = t.home;
const cityText = (city: string | Record<Language, string>) => (typeof city === 'string' ? city : city[language]);
---

<BaseLayout language={language} page="home" title={h.title} description={h.description} headerOverlay>
  <!-- HERO: the DJ portrait; on wide screens it fills the right side and
       fades into the obsidian room, the name sits on the left -->
  <section class="hero">
    <Image
      src={djPhoto}
      alt={h.hero.photoAlt}
      class="hero__photo"
      widths={[640, 960, 1280, 1597]}
      sizes="(min-width: 960px) 58vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__content">
      <h1 class="hero__name" translate="no">{t.meta.siteName}</h1>
      <span class="hero__line" aria-hidden="true"></span>
      <p class="hero__subtitle">{h.hero.label}</p>
      <p class="hero__text">{h.hero.text}</p>
      <div class="button-row hero__actions">
        <Button href={enquiryUrl(language, 'dj')} disc>{t.common.bookDj}</Button>
        <Button href={pageUrl(language, 'dj')} variant="secondary">{h.hero.secondaryCta}</Button>
      </div>
    </div>
  </section>

  <!-- MUSIC FOR THE DANCE FLOOR: the DJ offer and its formats, set as type
       (the hero already carries the photograph) -->
  <section class="section music" aria-labelledby="music-title">
    <div class="container music__grid">
      <div class="music__intro" data-reveal>
        <h2 id="music-title">{h.music.title}</h2>
        <p class="lead">{h.music.text}</p>
      </div>
      <div class="music__body" data-reveal style="--reveal-delay:120ms">
        <ol class="music__formats">
          {
            t.dj.formats.items.map((format) => (
              <li>
                <h3>{format.title}</h3>
                <p class="text">{format.text}</p>
              </li>
            ))
          }
        </ol>
        <Button href={enquiryUrl(language, 'dj')} disc>{t.common.bookDj}</Button>
      </div>
    </div>
  </section>

  <!-- WHERE I'VE PLAYED: real venues from tango-dj.md, set like a programme -->
  <section class="section played" aria-labelledby="played-title">
    <div class="container played__grid">
      <div class="played__head" data-reveal>
        <h2 id="played-title">{h.played.title}</h2>
        <a href={pageUrl(language, 'dj', '#experience-dj')} class="text-link">{h.played.cta}</a>
      </div>
      <ul class="played__list" data-reveal>
        {
          DJ_HIGHLIGHTS.map((highlight) => (
            <li>
              <span class="played__venue" translate="no">{highlight.venue}</span>
              <span class="played__city">
                <img src={`/flags/${highlight.country}.webp`} width="20" height="15" alt="" loading="lazy" decoding="async" />
                {cityText(highlight.city)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CLASSES: second business line, a quieter band -->
  <section class="section classes" aria-labelledby="classes-title">
    <div class="container classes__grid">
      <div class="classes__body" data-reveal>
        <h2 id="classes-title">{h.classes.title}</h2>
        <p class="lead">{h.classes.text}</p>
        <Button href={enquiryUrl(language, 'classes')} variant="secondary" disc>{h.classes.cta}</Button>
      </div>
      <div class="classes__photo" data-reveal-image>
        <!-- The source photo is 496px wide: never shown larger than that -->
        <Image src={classPhoto} alt={h.classes.photoAlt} widths={[496]} sizes="(min-width: 600px) 496px, 100vw" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ABOUT: from Buenos Aires to Berlin; the paintings only as a quiet link -->
  <section class="section" aria-labelledby="about-title">
    <div class="container about-teaser">
      <VinylSleeve class="about-teaser__sleeve">
        <Image src={portraitPhoto} alt={h.about.photoAlt} widths={[480, 800, 1048]} sizes="(min-width: 960px) 32vw, 78vw" loading="lazy" />
      </VinylSleeve>
      <div class="about-teaser__body" data-reveal>
        <h2 id="about-title">{h.about.title}</h2>
        <p class="lead">{h.about.text}</p>
        <Button href={pageUrl(language, 'about')} variant="secondary">{h.about.cta}</Button>
        <a href={pageUrl(language, 'art')} class="about-teaser__art">{h.about.artLink}</a>
      </div>
    </div>
  </section>

  <ContactCTA title={h.final.title} text={h.final.text} cta={t.common.bookDj} href={enquiryUrl(language, 'dj')} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(100svh, 40rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 28%;
  }

  /* Phones and tablets: the portrait fills the screen, darkened from below
     so the name and text read (diseno.md §5: grading only where type sits). */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--shade-hero-tall);
  }

  /* Wide screens: the portrait becomes a tall pane on the right that fades
     into the obsidian room; the dark studio backdrop makes the seam vanish. */
  @media (min-width: 960px) {
    .hero :global(.hero__photo) {
      left: auto;
      width: 58%;
      object-position: 50% 30%;
    }

    .hero__shade {
      background: var(--shade-hero-pane), var(--shade-hero-bottom);
    }
  }

  /* Small laptops: a narrower pane so the name never runs into the shoulder */
  @media (min-width: 960px) and (max-width: 1199px) {
    .hero :global(.hero__photo) {
      width: 50%;
    }

    .hero__shade {
      background: var(--shade-hero-pane-narrow), var(--shade-hero-bottom);
    }
  }

  .hero__content {
    display: grid;
    justify-items: start;
    padding-top: calc(var(--header-height) + var(--space-6));
    padding-bottom: clamp(3.5rem, 2rem + 6vh, 6.5rem);
  }

  .hero__name {
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.015em;
    max-width: 8.5em;
  }

  .hero__line {
    display: block;
    width: min(18rem, 60vw);
    height: 1px;
    margin-block: var(--space-3) var(--space-2);
    background: var(--color-accent);
    transform-origin: left;
  }

  /* The credit line of a record sleeve: "by Aaron Benchimol" */
  .hero__subtitle {
    margin-bottom: var(--space-2);
    font-size: var(--text-lead);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .hero__text {
    max-width: 30em;
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--color-text);
  }

  .hero__actions {
    margin-top: var(--space-4);
  }

  /* The opening moment: name rises in, the gold line is drawn under it,
     then the rest follows. Short, and never blocks reading. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__name {
      animation: hero-rise 900ms var(--ease-out) 100ms both;
    }

    .hero__line {
      animation: hero-line 1100ms var(--ease-in-out) 350ms both;
    }

    .hero__subtitle,
    .hero__text,
    .hero__actions {
      animation: hero-rise 700ms var(--ease-out) both;
    }

    .hero__subtitle {
      animation-delay: 650ms;
    }

    .hero__text {
      animation-delay: 740ms;
    }

    .hero__actions {
      animation-delay: 830ms;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }

  /* ---------- Music for the dance floor ---------- */
  .music__grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .music__intro {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .music__body {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  /* The three formats, set like a programme between fine rules */
  .music__formats {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .music__formats li {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border-soft);
  }

  @media (min-width: 960px) {
    .music__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-7);
      align-items: start;
    }
  }

  /* ---------- Where I've played ---------- */
  .played {
    border-top: 1px solid var(--color-border-soft);
  }

  .played__grid {
    display: grid;
    gap: var(--space-5);
  }

  .played__head {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: var(--space-3);
  }

  .played__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .played__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .played__venue {
    font-family: var(--font-display);
    font-size: var(--text-card);
    line-height: 1.2;
    color: var(--color-text);
  }

  .played__city img {
    width: 20px;
    height: 15px;
    box-shadow: 0 0 0 1px var(--color-border-soft);
  }

  .played__city {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (min-width: 960px) {
    .played__grid {
      grid-template-columns: 4fr 7fr;
      gap: var(--space-7);
    }
  }

  /* ---------- Classes (quieter band) ---------- */
  .classes {
    background: var(--color-surface);
  }

  .classes__grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .classes__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .classes__photo {
    overflow: hidden;
    width: 100%;
    max-width: 31rem; /* the photo's own width: no upscaling */
    aspect-ratio: 496 / 231;
    justify-self: end;
  }

  .classes__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 960px) {
    .classes__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-7);
    }
  }

  /* ---------- About teaser ---------- */
  .about-teaser {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .about-teaser :global(.about-teaser__sleeve) {
    max-width: 34rem;
  }

  .about-teaser :global(.about-teaser__sleeve img) {
    object-position: 40% 22%;
  }

  .about-teaser__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  /* The paintings, mentioned quietly: a muted text link, not a CTA */
  .about-teaser__art {
    display: inline-block;
    padding-block: 0.6rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-teaser__art {
      transition: color var(--dur-micro) ease, text-decoration-color var(--dur-micro) ease;
    }

    .about-teaser__art:hover {
      color: var(--color-text);
      text-decoration-color: var(--color-accent);
    }
  }

  @media (min-width: 960px) {
    .about-teaser {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-7);
    }
  }
</style>
