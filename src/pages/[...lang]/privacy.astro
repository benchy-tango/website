---
/** PRIVACY POLICY (Art. 13 GDPR). Texts in src/i18n/legal.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { LEGAL_TEXTS } from '../../i18n/legal';
import { languageStaticPaths, type Language } from '../../i18n/languages';

export const getStaticPaths = languageStaticPaths;

const { language } = Astro.props as { language: Language };
const legal = LEGAL_TEXTS[language];
---

<BaseLayout language={language} page="privacy" title={legal.privacy.title} description={legal.privacy.description}>
  <LegalPage language={language} page={legal.privacy} labels={legal.labels} />
</BaseLayout>
