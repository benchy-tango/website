---
/**
 * HOMEPAGE PROPOSAL (2026-10-20), not linked and noindex: the live Home is
 * still index.astro. Built on the owner's DJ poster (imagenes/home.jpg):
 * hero with the red-curtain triptych and the name under it like the poster →
 * two paragraphs right after the CTAs (who he is, where he plays now), the
 * residencies and the studio as records, quiet links → International DJ
 * experience by country (from experience.ts) → classes band → booking band.
 * Copy in src/i18n/home-b.ts.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { experiencesFor, textIn } from '../../data/experience';
import { HOME_B_TEXTS, RESIDENCIES } from '../../i18n/home-b';
import { enquiryUrl, getTranslation, languageStaticPaths, pageUrl, type Language } from '../../i18n/languages';
import triptychPhoto from '../../assets/photos/aaron-dj-triptych.jpg';

export const getStaticPaths = languageStaticPaths;

const { language } = Astro.props as { language: Language };
const t = getTranslation(language);
const h = t.home;
const b = HOME_B_TEXTS[language];

/* DJ experience grouped by country, like the poster: Argentina and Germany
   first (the two homes), then by number of entries. Newest venues first. */
const VENUES_SHOWN = 4;
const countryName = new Intl.DisplayNames([language], { type: 'region' });
const groups = new Map<string, { cities: Set<string>; venues: Set<string> }>();
for (const entry of experiencesFor('dj')) {
  if (!entry.country) continue;
  const group = groups.get(entry.country) ?? { cities: new Set(), venues: new Set() };
  if (entry.city) group.cities.add(textIn(entry.city, language));
  group.venues.add(textIn(entry.event, language).split(' – ')[0]);
  groups.set(entry.country, group);
}
const homes = ['ar', 'de'];
const countries = [...groups.entries()]
  .map(([code, group]) => ({
    code,
    name: countryName.of(code.toUpperCase()) ?? code,
    cities: [...group.cities].slice(0, 4),
    venues: [...group.venues].slice(0, VENUES_SHOWN),
    more: group.venues.size > VENUES_SHOWN,
    size: group.venues.size,
  }))
  .sort((x, y) => (homes.includes(y.code) ? 1 : 0) - (homes.includes(x.code) ? 1 : 0) || homes.indexOf(x.code) - homes.indexOf(y.code) || y.size - x.size);
const withCount = (text: string) => text.replace('{countries}', String(countries.length));
---

<BaseLayout language={language} page="homeB" title={b.title} description={withCount(b.description)} headerOverlay noindex>
  <!-- HERO: the triptych on the red curtain, full width; the name sits on
       its dark foot, centred like the poster -->
  <section class="hero">
    <div class="hero__stage">
      <Image
        src={triptychPhoto}
        alt={b.hero.photoAlt}
        class="hero__photo"
        widths={[640, 1024]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__shade" aria-hidden="true"></div>
    </div>
    <div class="container hero__content">
      <h1 class="hero__name" translate="no">{t.meta.siteName}</h1>
      <span class="hero__line" aria-hidden="true"></span>
      <p class="hero__credit">{b.hero.credit}</p>
      <p class="hero__text">{b.hero.text}</p>
      <div class="button-row hero__actions">
        <Button href={enquiryUrl(language, 'dj')} disc>{t.common.bookDj}</Button>
        <Button href={pageUrl(language, 'dj')} variant="secondary">{b.hero.secondaryCta}</Button>
      </div>
    </div>
  </section>

  <!-- WHO AARON IS AND WHERE HE PLAYS NOW: two paragraphs straight after the
       hero's calls to action, then the Berlin residencies as records -->
  <section class="story" aria-label={b.intro.title}>
    <div class="container">
      <div class="story__grid" data-reveal>
        <p class="story__text">{b.intro.lead} {b.intro.text}</p>
        <p class="story__text">{b.now.text}</p>
      </div>
      <ul class="now__list" data-reveal style="--reveal-delay:120ms">
        {
          RESIDENCIES.map((venue) => (
            <li class="now__item">
              <span class="now__disc" aria-hidden="true" />
              <span class="now__venue" translate="no">{venue}</span>
              <span class="now__role">{b.now.role}</span>
            </li>
          ))
        }
        <li class="now__item now__item--studio">
          <span class="now__disc now__disc--quiet" aria-hidden="true" />
          <span class="now__venue">{b.now.studio}</span>
          <span class="now__role">{b.now.studioText}</span>
        </li>
      </ul>
      <p class="story__links">
        <a href={pageUrl(language, 'about')} class="text-link">{b.intro.cta}</a>
        <a href={pageUrl(language, 'art')} class="story__art">{b.intro.artLink}</a>
      </p>
    </div>
  </section>

  <!-- INTERNATIONAL DJ EXPERIENCE: a summary by country, the full map lives on /dj/ -->
  <section class="section world" aria-labelledby="world-title">
    <div class="container">
      <div class="world__head" data-reveal>
        <h2 id="world-title" class="hairline-title">{b.world.title}</h2>
        <p class="lead">{withCount(b.world.text)}</p>
      </div>
      <ul class="world__list" data-reveal>
        {
          countries.map((country) => (
            <li class="world__country">
              <h3 class="world__name">
                <img src={`/flags/${country.code}.webp`} width="24" height="18" alt="" loading="lazy" decoding="async" />
                {country.name}
              </h3>
              {country.cities.length > 0 && <p class="world__cities" translate="no">{country.cities.join(', ')}</p>}
              <p class="world__venues">
                <span translate="no">{country.venues.join(', ')}</span>
                {country.more && <span class="world__more">, {b.world.more}</span>}
              </p>
            </li>
          ))
        }
      </ul>
      <div class="world__foot" data-reveal>
        <p class="world__note">{b.world.note}</p>
        <div class="button-row">
          <Button href={enquiryUrl(language, 'dj')} disc>{t.common.bookDj}</Button>
          <a href={pageUrl(language, 'dj', '#experience-dj')} class="text-link">{b.world.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CLASSES: second business line, a quieter band (same copy as the live Home) -->
  <section class="section classes" aria-labelledby="classes-title">
    <div class="container">
      <div class="classes__body" data-reveal>
        <h2 id="classes-title">{h.classes.title}</h2>
        <p class="lead">{h.classes.text}</p>
        <Button href={enquiryUrl(language, 'classes')} variant="secondary" disc>{h.classes.cta}</Button>
      </div>
    </div>
  </section>

  <ContactCTA title={h.final.title} text={h.final.text} cta={t.common.bookDj} href={enquiryUrl(language, 'dj')} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    align-content: start;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  /* The photo band: tall and cropped to the centre portrait on phones,
     the whole triptych at its own proportion on wide screens */
  .hero__stage {
    position: relative;
    height: clamp(22rem, 58svh, 34rem);
  }

  .hero :global(.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: var(--shade-hero-curtain);
  }

  @media (min-width: 760px) {
    .hero__stage {
      height: auto;
      width: min(100%, 96rem);
      margin-inline: auto;
      aspect-ratio: 1024 / 356;
      max-height: 68svh;
    }

    /* On very wide screens the band stops growing and its edges melt away */
    .hero__shade {
      background: var(--shade-hero-curtain), var(--shade-hero-curtain-sides);
    }
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    margin-top: clamp(-6rem, -7vw, -2.5rem);
    padding-bottom: clamp(3.5rem, 2rem + 6vh, 6rem);
    text-align: center;
  }

  .hero__name {
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hero__line {
    display: block;
    width: min(18rem, 60vw);
    height: 1px;
    margin-block: var(--space-3) var(--space-2);
    background: var(--color-accent);
  }

  .hero__credit {
    margin-bottom: var(--space-2);
    font-size: var(--text-lead);
    letter-spacing: 0.02em;
    color: var(--color-accent);
  }

  .hero__text {
    max-width: 34em;
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .hero__actions {
    justify-content: center;
    margin-top: var(--space-4);
  }

  /* The curtain opens: the photo settles from a slight zoom while the name
     rises and the gold line is drawn from the centre outwards. */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero__photo) {
      animation: hero-curtain 1600ms var(--ease-out) both;
    }

    .hero__name {
      animation: hero-rise 900ms var(--ease-out) 250ms both;
    }

    .hero__line {
      animation: hero-line 1100ms var(--ease-in-out) 500ms both;
    }

    .hero__credit,
    .hero__text,
    .hero__actions {
      animation: hero-rise 700ms var(--ease-out) both;
    }

    .hero__credit {
      animation-delay: 750ms;
    }

    .hero__text {
      animation-delay: 840ms;
    }

    .hero__actions {
      animation-delay: 930ms;
    }
  }

  @keyframes hero-curtain {
    from {
      opacity: 0.4;
      transform: scale(1.06);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }

  /* ---------- Who he is, and now ---------- */
  .story {
    padding-bottom: var(--section-y);
  }

  /* Two paragraphs side by side on wide screens, divided by a fine rule */
  .story__grid {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-soft);
  }

  .story__text {
    max-width: 38em;
    font-size: var(--text-lead);
    line-height: 1.75;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .story__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
  }

  /* The paintings, mentioned quietly: a muted text link, not a CTA */
  .story__art {
    display: inline-block;
    padding-block: 0.6rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
  }

  @media (hover: hover) and (pointer: fine) {
    .story__art {
      transition: color var(--dur-micro) ease, text-decoration-color var(--dur-micro) ease;
    }

    .story__art:hover {
      color: var(--color-text);
      text-decoration-color: var(--color-accent);
    }
  }

  @media (min-width: 960px) {
    .story__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
  }

  /* The residencies: one record per line on phones, three across on wide screens */
  .now__list {
    display: grid;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 960px) {
    .now__list {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--space-4);
    }
  }

  /* One record per line: the disc, the venue in Bodoni, the role */
  .now__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .now__disc {
    grid-row: 1 / 3;
    width: clamp(4rem, 3rem + 3vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    /* Same record as VinylSleeve: spindle, burgundy label with a gold ring, sheen, grooves */
    background:
      radial-gradient(circle closest-side, var(--color-bg) 0 5%, transparent 5.5%),
      radial-gradient(circle closest-side, var(--color-burgundy) 0 34%, var(--color-accent) 34.5% 36%, transparent 36.5%),
      conic-gradient(from 20deg, transparent 0 8%, rgba(245, 239, 223, 0.09) 14%, transparent 22% 58%, rgba(245, 239, 223, 0.07) 64%, transparent 72%),
      repeating-radial-gradient(circle closest-side, #141414 0 2px, #262626 2.5px 3px, #141414 3.5px 4.5px),
      #141414;
    box-shadow: 0 0 0 1px rgba(245, 239, 223, 0.1);
  }

  /* The studio is not a residency: its record has a charcoal label */
  .now__disc--quiet {
    background:
      radial-gradient(circle closest-side, var(--color-bg) 0 5%, transparent 5.5%),
      radial-gradient(circle closest-side, var(--color-charcoal) 0 34%, var(--color-border) 34.5% 36%, transparent 36.5%),
      repeating-radial-gradient(circle closest-side, #141414 0 2px, #262626 2.5px 3px, #141414 3.5px 4.5px),
      #141414;
  }

  .now__venue {
    align-self: end;
    font-family: var(--font-display);
    font-size: var(--text-card);
    line-height: 1.2;
  }

  .now__role {
    align-self: start;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .now__item--studio .now__role {
    color: var(--color-text-muted);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .now__item:hover .now__disc {
      animation: record-spin 2.4s linear infinite;
    }
  }

  @keyframes record-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ---------- International DJ experience ---------- */
  .world {
    background: var(--color-surface);
  }

  .world__head {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
    margin-bottom: var(--space-5);
  }

  /* The poster's three columns: countries flow down, never split */
  .world__list {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 1;
    column-gap: var(--space-6);
  }

  .world__country {
    display: grid;
    gap: 0.35rem;
    padding-block: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-border-soft);
    break-inside: avoid;
  }

  .world__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-card);
    line-height: 1.2;
  }

  .world__name img {
    width: 24px;
    height: 18px;
    box-shadow: 0 0 0 1px var(--color-border-soft);
  }

  .world__cities {
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .world__venues {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .world__more {
    font-style: italic;
  }

  .world__foot {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .world__note {
    max-width: 44em;
    font-size: var(--text-small);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (min-width: 680px) {
    .world__list {
      columns: 2;
    }
  }

  @media (min-width: 1080px) {
    .world__list {
      columns: 3;
    }
  }

  /* ---------- Classes (quieter band) ---------- */
  .classes__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    max-width: 46rem;
  }
</style>
