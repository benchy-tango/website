---
/**
 * TANGO DJ (the main business): intro + booking CTA → "From the dance floor
 * to the booth" (DJ portrait, approach) → formats → the Golden Age
 * orchestras → where he has played (map + country filter) → booking band.
 * Facts from ../wesite-info/tango-dj.md and aaron_benchimol_dj-history.md. Every booking CTA
 * opens the contact form with "dj" already chosen.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ExperienceMap from '../../components/ExperienceMap.astro';
import { GOLDEN_AGE_ORCHESTRAS } from '../../data/dj';
import { enquiryUrl, getTranslation, languageStaticPaths, type Language } from '../../i18n/languages';
import djPhoto from '../../assets/photos/aaron-dj.jpg';

export const getStaticPaths = languageStaticPaths;

const { language } = Astro.props as { language: Language };
const t = getTranslation(language);
const d = t.dj;
---

<BaseLayout language={language} page="dj" title={d.title} description={d.description}>
  <PageIntro title={d.title} text={d.intro}>
    <Button href={enquiryUrl(language, 'dj')} arrow>{t.common.bookDj}</Button>
  </PageIntro>

  <!-- FROM THE DANCE FLOOR TO THE BOOTH -->
  <section class="section origin" aria-labelledby="origin-title">
    <div class="container origin__grid">
      <div class="origin__photo" data-reveal-image>
        <Image src={djPhoto} alt={d.origin.photoAlt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 42vw, 100vw" loading="lazy" />
      </div>
      <div class="origin__body" data-reveal>
        <h2 id="origin-title">{d.origin.title}</h2>
        <p class="lead">{d.origin.text}</p>
        <p class="label">{d.origin.approachLabel}</p>
        <ul class="programme-list">
          {d.origin.approach.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FORMATS -->
  <section class="section formats" id="formats" aria-labelledby="formats-title">
    <div class="container">
      <h2 id="formats-title" data-reveal>{d.formats.title}</h2>
      <ol class="formats__list">
        {
          d.formats.items.map((format, index) => (
            <li class="formats__item" data-reveal style={`--reveal-delay:${index * 90}ms`}>
              <h3>{format.title}</h3>
              <p class="text">{format.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- THE GOLDEN AGE: the orchestras, set like names on a milonga poster -->
  <section class="section repertoire" aria-labelledby="repertoire-title">
    <div class="container container--narrow repertoire__inner" data-reveal>
      <h2 id="repertoire-title">{d.repertoire.title}</h2>
      <p class="lead">{d.repertoire.text}</p>
      <ul class="repertoire__orchestras" translate="no">
        {GOLDEN_AGE_ORCHESTRAS.map((orchestra) => <li>{orchestra}</li>)}
      </ul>
    </div>
  </section>

  <!-- WHERE I'VE PLAYED: map with a country filter (src/data/experience.ts) -->
  <ExperienceMap language={language} tag="dj" title={d.experience.title} text={d.experience.text} />

  <ContactCTA title={d.final.title} text={d.final.text} cta={t.common.bookDj} href={enquiryUrl(language, 'dj')} />
</BaseLayout>

<style>
  /* ---------- Origin ---------- */
  .origin {
    padding-top: 0;
  }

  .origin__grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .origin__photo {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 34rem;
    background: var(--color-surface);
  }

  .origin__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 30%;
  }

  .origin__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .origin__body .label {
    margin-top: var(--space-2);
  }

  @media (min-width: 960px) {
    .origin__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-7);
    }
  }

  /* ---------- Formats: three programme columns between fine rules ---------- */
  .formats {
    border-top: 1px solid var(--color-border-soft);
  }

  .formats__list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .formats__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 760px) {
    .formats__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  /* ---------- Repertoire ---------- */
  .repertoire {
    background: var(--color-surface);
    text-align: center;
  }

  .repertoire__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }

  .repertoire__orchestras {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-card);
    line-height: 1.3;
    color: var(--color-text);
  }

  /* Phones: one orchestra per line */
  @media (max-width: 639px) {
    .repertoire__orchestras {
      flex-direction: column;
      align-items: center;
    }
  }

  /* Wider screens: a small gold dot between names, like a printed milonga poster */
  @media (min-width: 640px) {
    .repertoire__orchestras li + li::before {
      content: '·';
      margin-right: var(--space-3);
      color: var(--color-accent);
    }
  }
</style>
