---
/**
 * Slim fixed header: wordmark left, navigation right, Contact emphasised,
 * EN / ES switch. It is transparent over the homepage hero and turns solid
 * once the page scrolls (data-scrolled). On small screens the navigation
 * moves into a full-screen <dialog> (focus stays inside, Escape closes it);
 * without JavaScript the links simply wrap under the wordmark.
 */
import Icon from './Icon.astro';
import { LANGUAGES, LANGUAGE_DETAILS, getTranslation, pageUrl, type Language, type PageName } from '../i18n/languages';

interface Props {
  language: Language;
  page: PageName;
  /** Transparent at the top (pages that open with a full-bleed image). */
  overlay?: boolean;
}

const { language, page, overlay = false } = Astro.props;
const t = getTranslation(language).navigation;

const links: { page: PageName; label: string }[] = [
  { page: 'danceMusic', label: t.danceMusic },
  { page: 'art', label: t.art },
  { page: 'about', label: t.about },
];
---

<header class="site-header" data-site-header data-overlay={overlay ? 'true' : 'false'} data-scrolled="false">
  <div class="container site-header__bar">
    <a href={pageUrl(language, 'home')} class="wordmark" aria-current={page === 'home' ? 'page' : undefined}>
      Aaron Benchimol
    </a>

    <nav class="site-nav" aria-label={t.mainLabel}>
      <ul class="site-nav__list">
        {
          links.map((link) => (
            <li>
              <a href={pageUrl(language, link.page)} class="site-nav__link" aria-current={link.page === page ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={pageUrl(language, 'contact')} class="site-nav__contact" aria-current={page === 'contact' ? 'page' : undefined}>
            {t.contact}
          </a>
        </li>
      </ul>

      <ul class="language-switch" aria-label={t.language}>
        {
          LANGUAGES.map((code) => (
            <li>
              <a
                href={pageUrl(code, page)}
                hreflang={LANGUAGE_DETAILS[code].htmlLang}
                lang={LANGUAGE_DETAILS[code].htmlLang}
                aria-current={code === language ? 'true' : undefined}
              >
                <span aria-hidden="true">{LANGUAGE_DETAILS[code].short}</span>
                <span class="visually-hidden">{LANGUAGE_DETAILS[code].name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" class="menu-button" aria-controls="mobile-menu" aria-expanded="false" aria-label={t.openMenu} data-open-menu>
      <Icon name="menu" />
    </button>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label={t.mainLabel} data-mobile-menu>
  <div class="container mobile-menu__top">
    <a href={pageUrl(language, 'home')} class="wordmark">Aaron Benchimol</a>
    <button type="button" class="menu-button" aria-label={t.closeMenu} data-close-menu>
      <Icon name="close" />
    </button>
  </div>
  <nav class="container mobile-menu__nav" aria-label={t.mainLabel}>
    <ul>
      {
        [{ page: 'home' as PageName, label: t.home }, ...links, { page: 'contact' as PageName, label: t.contact }].map((link, index) => (
          <li style={`--i:${index}`}>
            <a href={pageUrl(language, link.page)} aria-current={link.page === page ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="language-switch language-switch--menu" aria-label={t.language}>
      {
        LANGUAGES.map((code) => (
          <li>
            <a href={pageUrl(code, page)} hreflang={LANGUAGE_DETAILS[code].htmlLang} lang={LANGUAGE_DETAILS[code].htmlLang} aria-current={code === language ? 'true' : undefined}>
              {LANGUAGE_DETAILS[code].name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border-soft);
    transition:
      background-color var(--dur-micro) ease,
      border-color var(--dur-micro) ease;
  }

  /* Over a full-bleed image: transparent until the page scrolls */
  .site-header[data-overlay='true'][data-scrolled='false'] {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }

  .site-nav__list,
  .language-switch {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list {
    gap: var(--space-3);
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--dur-micro) ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-text);
  }

  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav__link:hover {
      color: var(--color-text);
    }

    .site-nav__link:hover::after {
      transform: scaleX(1);
    }

    .site-nav__contact:hover {
      border-color: var(--color-text);
    }

    .language-switch a:hover {
      color: var(--color-text);
    }
  }

  /* Contact: clear but restrained emphasis (architecture §4) */
  .site-nav__contact {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-outline);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--dur-micro) ease;
  }

  /* Ivory outline in every state: gold stays for each page's own primary action */
  .site-nav__contact[aria-current='page'] {
    border-color: var(--color-text);
  }

  .language-switch {
    gap: 0.25rem;
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--dur-micro) ease;
  }

  .language-switch a[aria-current='true'] {
    color: var(--color-accent);
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.75rem;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-button :global(.icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  @media (min-width: 960px) {
    .site-nav {
      display: flex;
    }

    .menu-button {
      display: none;
    }
  }

  /* Without JavaScript the menu button cannot work: show the links instead. */
  @media (max-width: 959px) {
    :global(html:not(.js)) .site-header__bar {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }

    :global(html:not(.js)) .site-nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    :global(html:not(.js)) .menu-button {
      display: none;
    }
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu::backdrop {
    background: var(--color-bg);
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .mobile-menu__nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--space-5) var(--space-4);
  }

  .mobile-menu__nav ul:first-child {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu__nav ul:first-child a {
    display: block;
    padding-block: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 2.75rem);
    line-height: 1.15;
    text-decoration: none;
  }

  .mobile-menu__nav ul:first-child a[aria-current='page'] {
    color: var(--color-accent);
  }

  .language-switch--menu {
    padding: var(--space-3) 0 0;
    border-left: 0;
    border-top: 1px solid var(--color-border-soft);
    gap: var(--space-3);
  }

  .language-switch--menu a {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    min-height: 2.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 260ms var(--ease-out);
    }

    .mobile-menu[open] .mobile-menu__nav ul:first-child li {
      animation: menu-link-in 420ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 45ms);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-link-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-open-menu]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-close-menu]');

  // Solid header once the page has scrolled a little.
  if (header) {
    const update = () => header.setAttribute('data-scrolled', String(window.scrollY > 24));
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  if (menu && openButton) {
    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    closeButton?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
    // Leaving the menu to another page or section: close it first.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
    // Back to desktop width with the menu open: close it.
    window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
