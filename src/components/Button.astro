---
/**
 * Link styled as a button (diseno.md §3): gold primary for the main
 * action, outline secondary (fills with burgundy on hover). `disc` adds a
 * small vinyl record after the label that spins while hovered. Styles live in global.css (.button).
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  /** Shows the vinyl record icon after the label. */
  disc?: boolean;
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', disc = false, external = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['button', `button--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  {disc && <Icon name="vinyl" class="button__disc" />}
</a>

<style>
  .button :global(.button__disc) {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* The record turns while the pointer rests on the button (constant motion: linear) */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .button:hover :global(.button__disc) {
      animation: disc-spin 1.6s linear infinite;
    }
  }

  @keyframes disc-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
